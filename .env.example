MYSQL_DATABASE=airlines
MYSQL_USERNAME=root
MYSQL_PASSWORD=

JWT_SECRET=super_secret_jwt_key_that_needs_to_be_long_enough_for_hs256_algorithm

# Microservice Endpoints
CORE_SERVICE_URL=http://core-service:8080
AI_SERVICE_URL=http://ai-service:8000
JAVA_API_URL=http://core-service:8080
VITE_API_BASE_URL=/api

# AI Intelligence Configuration (Cloud / Local Ollama / Deterministic Fallback)
AI_ENABLED=true
AI_PROVIDER=auto
AI_MODEL=gpt-4o-mini
AI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3:latest
USE_DETERMINISTIC_AI=false

# Pixabay Image Cache (Optional)
PIXABAY_API_KEY=
PIXABAY_API_URL=https://pixabay.com/api/

# Email & Notification Settings (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
